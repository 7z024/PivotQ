---
import { ArrowUpRight } from '@lucide/astro';
import PortalHeader from '../components/PortalHeader.astro';
import { site } from '../data/site';
import '../styles/global.css';
import '../styles/flow-global.css';

interface Props { title?: string; description?: string; page?: string; }
const { title, description = site.description, page = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL;
const active = page === 'docs' ? 'docs' : page === 'aimd' || page === 'qram' ? 'applications' : 'home';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {page === '404' && <meta name="robots" content="noindex" />}
    {Astro.site && page !== '404' && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title ? `${title} · ${site.name}` : `${site.name} · 量超智融合系统`}</title>
  </head>
  <body class="flow-site" data-page={page}>
    <a class="skip-link" href="#main">跳转到正文</a>
    <header class="site-header flow-header">
      <PortalHeader active={active} />
    </header>
    <main id="main"><slot /></main>
    <footer class="flow-footer">
      <div class="container flow-footer-main"><div><a class="flow-footer-brand" href={base}>PivotQ</a><p>协同 CPU、GPU 与 QPU，组织计算步骤、评估性能并查看结果。</p></div><nav aria-label="页脚导航"><a href={`${base}docs/`}>参考文档</a><a href={`${base}examples/aimd/`}>水分子 AIMD</a><a href={`${base}examples/qram/`}>QRAM</a><a href={site.githubUrl} target="_blank" rel="noopener noreferrer">GitHub <ArrowUpRight size={14} /></a></nav></div>
      <div class="container flow-footer-bottom"><span>© {new Date().getFullYear()} PivotQ</span></div>
    </footer>
  </body>
</html>
