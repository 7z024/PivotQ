---
import { Code } from '@astrojs/starlight/components';
import { docsExampleSource } from '../lib/docs-example-source';

interface Props { example: 'workflow' | 'performance' | 'provider' }
const examples = {
  workflow: { source: docsExampleSource('system_workflow.py'), filename: 'system_workflow.py' },
  performance: { source: docsExampleSource('performance_prediction.py'), filename: 'performance_prediction.py' },
  provider: { source: docsExampleSource('custom_backend.py'), filename: 'custom_backend.py' },
};
const { source, filename } = examples[Astro.props.example];
---
<Code code={source} lang="python" title={filename} />
