---
import { ChevronLeft, ChevronRight, Clock3, Cpu, ListChecks, Orbit, ScanLine } from '@lucide/astro';
import '../styles/flow-workbench.css';
---
<div class="flow-workspace" data-flow-workspace data-flow-mode="compose">
  <div class="flow-workspace-toolbar">
    <div class="flow-workspace-headerline">
      <div class="flow-workspace-title"><span class="flow-workspace-led"></span><strong>混合计算工作流</strong></div>
      <div class="flow-workspace-rail-nav" aria-label="工作流节点导航">
        <button type="button" data-flow-prev aria-controls="flow-workspace-panel" aria-label="上一个工作流节点" title="上一个工作流节点" disabled><ChevronLeft size={17} /></button>
        <button type="button" data-flow-next aria-controls="flow-workspace-panel" aria-label="下一个工作流节点" title="下一个工作流节点"><ChevronRight size={17} /></button>
      </div>
    </div>
    <div class="flow-mode-switch" role="tablist" aria-label="工作流阶段" aria-orientation="horizontal">
      <button id="flow-tab-compose" type="button" role="tab" data-mode="compose" aria-controls="flow-workspace-panel" aria-selected="true" tabindex="0">任务编排</button>
      <button id="flow-tab-predict" type="button" role="tab" data-mode="predict" aria-controls="flow-workspace-panel" aria-selected="false" tabindex="-1">性能模拟</button>
      <button id="flow-tab-execute" type="button" role="tab" data-mode="execute" aria-controls="flow-workspace-panel" aria-selected="false" tabindex="-1">运行记录</button>
    </div>
  </div>
  <div id="flow-workspace-panel" class="flow-workspace-canvas" tabindex="0" role="tabpanel" aria-labelledby="flow-tab-compose" aria-description="量子-经典混合计算的五步流程，小屏幕可横向滚动查看">
    <div class="flow-workspace-track" role="list" aria-label="混合计算的五个步骤">
      <div class="flow-node flow-node-source" role="listitem"><span class="flow-node-port flow-node-port-right"></span><span class="flow-node-step">01 / 程序</span><div class="flow-node-name"><ScanLine size={20} /><strong>量子-经典<br />混合程序</strong></div><p>用代码描述计算步骤与参数</p></div>
      <div class="flow-edge" aria-hidden="true"><span class="flow-edge-pulse"></span></div>
      <div class="flow-node flow-node-resources" role="listitem"><span class="flow-node-port flow-node-port-left"></span><span class="flow-node-port flow-node-port-right"></span><span class="flow-node-step">02 / 设备</span><div class="flow-node-name"><Cpu size={20} /><strong>选择设备</strong></div><div class="flow-resource-tags"><span data-resource="cpu">CPU</span><span data-resource="gpu">GPU</span><span data-resource="qpu">QPU</span></div><p>为计算步骤指定目标设备</p></div>
      <div class="flow-edge" aria-hidden="true"><span class="flow-edge-pulse"></span></div>
      <div class="flow-node" role="listitem" data-flow-stage="compose" data-flow-active="true" aria-current="step"><span class="flow-node-port flow-node-port-left"></span><span class="flow-node-port flow-node-port-right"></span><span class="flow-node-step">03 / 编排</span><div class="flow-node-name"><Orbit size={20} /><strong>任务编排</strong></div><p>编译量子电路，组织任务依赖</p></div>
      <div class="flow-edge" aria-hidden="true"><span class="flow-edge-pulse"></span></div>
      <div class="flow-node" role="listitem" data-flow-stage="predict"><span class="flow-node-port flow-node-port-left"></span><span class="flow-node-port flow-node-port-right"></span><span class="flow-node-step">04 / 预测</span><div class="flow-node-name"><Clock3 size={20} /><strong>性能模拟</strong></div><p>按目标设备参数预测执行时间</p></div>
      <div class="flow-edge" aria-hidden="true"><span class="flow-edge-pulse"></span></div>
      <div class="flow-node" role="listitem" data-flow-stage="execute"><span class="flow-node-port flow-node-port-left"></span><span class="flow-node-step">05 / 结果</span><div class="flow-node-name"><ListChecks size={20} /><strong>运行记录</strong></div><p>运行后查看实际用时与结果</p></div>
    </div>
  </div>
  <span class="flow-workspace-announcement" data-flow-status role="status" aria-live="polite" aria-atomic="true">当前阶段：第3步，任务编排。</span>
</div>
<script>
  const modes = {
    compose: '当前阶段：第3步，任务编排。',
    predict: '当前阶段：第4步，性能模拟。',
    execute: '当前阶段：第5步，运行记录。',
  } as const;
  document.querySelectorAll<HTMLElement>('[data-flow-workspace]').forEach(root => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mode]'));
    const panel = root.querySelector<HTMLElement>('[role="tabpanel"]');
    const nodes = Array.from(panel?.querySelectorAll<HTMLElement>('.flow-node') ?? []);
    const previousNode = root.querySelector<HTMLButtonElement>('[data-flow-prev]');
    const nextNode = root.querySelector<HTMLButtonElement>('[data-flow-next]');
    const updateNodeButtons = () => {
      if (!panel || !previousNode || !nextNode) return;
      const lastScroll = Math.max(0, panel.scrollWidth - panel.clientWidth);
      root.dataset.flowOverflow = String(lastScroll > 1);
      previousNode.disabled = panel.scrollLeft <= 1;
      nextNode.disabled = panel.scrollLeft >= lastScroll - 1;
    };
    const moveToNode = (direction: -1 | 1) => {
      if (!panel || !nodes.length) return;
      const starts = nodes.map(node => node.offsetLeft - nodes[0].offsetLeft);
      const target = direction === 1
        ? starts.find(start => start > panel.scrollLeft + 1)
        : starts.findLast(start => start < panel.scrollLeft - 1);
      if (target === undefined) return;
      panel.scrollTo({ left: target, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    previousNode?.addEventListener('click', () => moveToNode(-1));
    nextNode?.addEventListener('click', () => moveToNode(1));
    panel?.addEventListener('scroll', updateNodeButtons, { passive: true });
    window.addEventListener('resize', updateNodeButtons);
    updateNodeButtons();
    const show = (mode: keyof typeof modes) => {
      root.dataset.flowMode = mode;
      tabs.forEach(tab => {
        const selected = tab.dataset.mode === mode;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      panel?.setAttribute('aria-labelledby', `flow-tab-${mode}`);
      nodes.forEach(node => {
        const selected = node.dataset.flowStage === mode;
        if (selected) {
          node.dataset.flowActive = 'true';
          node.setAttribute('aria-current', 'step');
        } else {
          delete node.dataset.flowActive;
          node.removeAttribute('aria-current');
        }
      });
      const status = root.querySelector<HTMLElement>('[data-flow-status]');
      if (status) status.textContent = modes[mode];
      const activeNode = nodes.find(node => node.dataset.flowStage === mode);
      if (!panel || !activeNode || panel.scrollWidth <= panel.clientWidth + 1) return;
      const viewport = panel.getBoundingClientRect();
      const active = activeNode.getBoundingClientRect();
      if (active.left >= viewport.left + 12 && active.right <= viewport.right - 12) return;
      panel.scrollTo({
        left: panel.scrollLeft + active.left - viewport.left - (panel.clientWidth - active.width) / 2,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => show(tab.dataset.mode as keyof typeof modes));
      tab.addEventListener('keydown', event => {
        let targetIndex: number;
        switch (event.key) {
          case 'ArrowLeft': targetIndex = (index - 1 + tabs.length) % tabs.length; break;
          case 'ArrowRight': targetIndex = (index + 1) % tabs.length; break;
          case 'Home': targetIndex = 0; break;
          case 'End': targetIndex = tabs.length - 1; break;
          default: return;
        }
        event.preventDefault();
        const target = tabs[targetIndex];
        target.focus(); target.click();
      });
    });
  });
</script>
