{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://single-h20-aimd.local/schemas/fusion-actor-call-request-v1.json",
    "title": "Standalone H2O Classical Actor Call Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "run_id", "task_id", "method", "payload", "timeout_seconds", "metadata"],
  "properties": {
    "api_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "method": {"const": "predict"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "sample_ids", "features"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "sample_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "features": {
          "type": "array",
          "minItems": 1,
                    "items": {
                        "type": "array",
                        "minItems": 14,
                        "maxItems": 14,
                        "items": {"type": "number"}
                    }
        }
      }
    },
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "metadata": {"type": "object"}
  }
}
